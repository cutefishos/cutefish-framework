msgid "Bluetooth isn't ready yet. Try again in a moment."
msgstr "Bluetooth henüz hazır değil. Biraz sonra yeniden deneyin."

#: clients/bluez/manager.cpp
msgid "This device has no media player."
msgstr "Bu aygıtta ortam oynatıcı yok."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent: no system bus."
msgstr "Bluetooth eşleştirme aracısı dışa aktarılamıyor: sistem veri yolu yok."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent."
msgstr "Bluetooth eşleştirme aracısı dışa aktarılamıyor."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "1–16 bayt içeren bir PIN girin."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "1–6 basamak içeren bir geçiş anahtarı girin."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "{device} aygıtına bağlanılamadı"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "Aygıta bağlanılamadı"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "{device} aygıtının bağlantısı kesilemedi"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "Aygıtın bağlantısı kesilemedi"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "{device} ile eşleştirilemedi"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "Aygıt ile eşleştirilemedi"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "{device} unutulamadı"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "Aygıt unutulamadı"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Yeniden deneyin. Başarısız olmaya devam ederse aygıtı kapatıp tekrar açın."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "Aygıt zamanında yanıt vermedi. Açık ve yakında olduğundan emin olun."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "Aygıt yanıt vermedi. Açık, yakında ve başka bir aygıta bağlı olmadığından emin olun."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "Aygıt artık bu bilgisayarı tanımıyor. Aygıtı unutun ve yeniden eşleştirin."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "Eşleştirme başarısız oldu. Kodun her iki aygıtta da eşleştiğinden emin olun ve yeniden deneyin."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "Aygıt isteği reddetti."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "Aygıt bağlantıyı reddetti."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "Aygıtta bu bilgisayarın kullanabileceği herhangi bir özellik yok."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Bluetooth kapalı."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Çok fazla aygıt bağlı. Birinin bağlantısını kesin ve yeniden deneyin."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "Aygıt bağlantıyı sonlandırdı."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "Bağlantı kesintiye uğradı. Yeniden deneyin."

