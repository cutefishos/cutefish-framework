#: clients/networkmanager/vpn_schema.cpp
msgid "Enter the tunnel domain."
msgstr "Tünel etki alanını girin."

#: clients/networkmanager/vpn_schema.cpp
#, python-brace-format
msgid "Fill in “{field}”."
msgstr "“{field}” alanını doldurun."

#: clients/networkmanager/vpn_schema.cpp
msgid "This kind of VPN can't be set up by hand."
msgstr "Bu tür bir VPN el ile kurulamaz."

#: clients/networkmanager/vpn_schema.cpp
#, python-brace-format
msgid "{field} must be a number from {minimum} to {maximum}."
msgstr "{field} değeri {minimum} ile {maximum} arasında bir sayı olmalıdır."

#: clients/networkmanager/vpn_utils.cpp
msgid "The network connection was interrupted."
msgstr "Ağ bağlantısı kesintiye uğradı."

#: clients/networkmanager/vpn_utils.cpp
msgid "The VPN service stopped unexpectedly."
msgstr "VPN hizmeti beklenmedik şekilde durdu."

#: clients/networkmanager/vpn_utils.cpp
msgid "The VPN service returned invalid configuration."
msgstr "VPN hizmeti geçersiz yapılandırma döndürdü."

#: clients/networkmanager/vpn_utils.cpp
msgid "The connection attempt timed out."
msgstr "Bağlantı girişimi zaman aşımına uğradı."

#: clients/networkmanager/vpn_utils.cpp
msgid "The VPN service did not start in time."
msgstr "VPN hizmeti zamanında başlamadı."

#: clients/networkmanager/vpn_utils.cpp
msgid "The VPN service failed to start."
msgstr "VPN hizmeti başlatılamadı."

#: clients/networkmanager/vpn_utils.cpp
msgid "Sign-in failed. Check the user name and password."
msgstr "Oturum açılamadı. Kullanıcı adını ve parolayı denetleyin."

#: clients/networkmanager/vpn_utils.cpp
msgid "The VPN service reported an error."
msgstr "VPN hizmeti bir hata bildirdi."

#: clients/networkmanager/vpn_utils.cpp
msgid "DNS tunnel (iodine)"
msgstr "DNS tüneli (iodine)"

#. TRANSLATORS: {key} is a WireGuard setting as written in the file, such as "PrivateKey".
#: clients/networkmanager/vpn_utils.cpp
#, python-brace-format
msgid "Line {line} has an invalid {key}."
msgstr "{line}. satırda geçersiz bir {key} değeri var."

#: clients/networkmanager/vpn_utils.cpp
#, python-brace-format
msgid "Line {line} isn't part of a WireGuard configuration."
msgstr "{line}. satır bir WireGuard yapılandırmasının parçası değil."

#: clients/networkmanager/vpn_utils.cpp
msgid "The configuration has no private key."
msgstr "Yapılandırmada özel anahtar yok."

#: clients/networkmanager/vpn_utils.cpp
msgid "A peer has no public key."
msgstr "Bir eşin genel anahtarı yok."

#: clients/networkmanager/vpn_utils.cpp
msgid "Enter the private key."
msgstr "Özel anahtarı girin."

#: clients/networkmanager/vpn_utils.cpp
msgid "The private key isn't a WireGuard key."
msgstr "Özel anahtar geçerli bir WireGuard anahtarı değil."

#: clients/networkmanager/vpn_utils.cpp
#, python-brace-format
msgid "{address} isn't an address with a prefix, like 10.0.0.2/24."
msgstr "{address}, 10.0.0.2/24 gibi ön ekli bir adres değil."

#: clients/networkmanager/vpn_utils.cpp
msgid "Enter the address."
msgstr "Adresi girin."

#: clients/networkmanager/vpn_utils.cpp
msgid "The listen port must be a number up to 65535."
msgstr "Dinleme bağlantı noktası en fazla 65535 olan bir sayı olmalıdır."

#: clients/networkmanager/vpn_utils.cpp
msgid "The firewall mark must be a number."
msgstr "Güvenlik duvarı işareti bir sayı olmalıdır."

#: clients/networkmanager/vpn_utils.cpp
msgid "The MTU must be a number."
msgstr "MTU değeri bir sayı olmalıdır."

#: clients/networkmanager/vpn_utils.cpp
msgid "Add the server as a peer."
msgstr "Sunucuyu eş olarak ekleyin."

#: clients/networkmanager/vpn_utils.cpp
msgid "A peer's public key isn't a WireGuard key."
msgstr "Bir eşin genel anahtarı geçerli bir WireGuard anahtarı değil."

#: clients/networkmanager/vpn_utils.cpp
msgid "A peer's preshared key isn't a WireGuard key."
msgstr "Bir eşin önceden paylaşılan anahtarı geçerli bir WireGuard anahtarı değil."

#: clients/networkmanager/vpn_utils.cpp
#, python-brace-format
msgid "{address} isn't a network, like 10.0.0.0/24."
msgstr "{address}, 10.0.0.0/24 gibi bir ağ adresi değil."

#: clients/networkmanager/vpn_utils.cpp
msgid "The keepalive must be a number of seconds up to 65535."
msgstr "Canlı tutma süresi en fazla 65535 saniye olmalıdır."

#. TRANSLATORS: a Wi-Fi network's security type.
#: clients/networkmanager/wifi_utils.cpp
msgid "Insecure"
msgstr "Güvensiz"

#: clients/networkmanager/wifi_utils.cpp
msgid "Dynamic WEP"
msgstr "Dinamik WEP"

#. TRANSLATORS: a Wi-Fi network's security type.
#: clients/networkmanager/wifi_utils.cpp
msgid "Unknown"
msgstr "Bilinmeyen"

#. TRANSLATORS: why a folder can't be listed, then the folder, such as "Permission denied: /root".
#: files/directory_lister.cpp
#, python-brace-format
msgid "{error}: {path}"
msgstr "{error}: {path}"

#: files/file_watcher.cpp
#, python-brace-format
msgid "Cannot watch {paths}; polling for changes"
msgstr "{paths} izlenemiyor; değişiklikler yoklanıyor"

#. TRANSLATORS: the file an operation failed on, then why, such as "/tmp/a.txt: Permission denied".
#: files/task.cpp
#, python-brace-format
msgid "{path}: {error}"
msgstr "{path}: {error}"

#: files/trash.cpp
msgid "The original location is not known"
msgstr "Özgün konum bilinmiyor"

#: files/trash.cpp
msgid "The original location is outside the volume it was deleted on"
msgstr "Özgün konum, silindiği birimin dışında"

#. TRANSLATORS: a disk without a label, named by its size, such as "16 GB Volume".
#: files/volume_manager.cpp
#, python-brace-format
msgid "{size} Encrypted Volume"
msgstr "{size} Şifreli Birim"

#: files/volume_manager.cpp
#, python-brace-format
msgid "{size} Volume"
msgstr "{size} Birim"

#: files/volume_manager.cpp
msgid "The device is locked."
msgstr "Aygıt kilitli."

#: files/volume_manager.cpp
msgid "The device does not support this operation."
msgstr "Aygıt bu işlemi desteklemiyor."

#: files/volume_manager.cpp
msgid "A device operation is already in progress."
msgstr "Bir aygıt işlemi zaten sürüyor."

#: files/volume_manager.cpp
msgid "The device is no longer available."
msgstr "Aygıt artık kullanılamıyor."

