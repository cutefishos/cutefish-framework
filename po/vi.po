msgstr "Giới hạn kích thước phân đoạn TCP tối đa"

#: clients/networkmanager/vpn_schema.cpp
msgid "Path MTU discovery"
msgstr "Dò tìm MTU đường truyền"

#: clients/networkmanager/vpn_schema.cpp
msgid "Never"
msgstr "Không bao giờ"

#: clients/networkmanager/vpn_schema.cpp
msgid "When possible"
msgstr "Khi có thể"

#: clients/networkmanager/vpn_schema.cpp
msgid "Always"
msgstr "Luôn luôn"

#: clients/networkmanager/vpn_schema.cpp
msgid "Renegotiate every (seconds)"
msgstr "Thương lượng lại sau mỗi (giây)"

#: clients/networkmanager/vpn_schema.cpp
msgid "Compression"
msgstr "Nén"

#: clients/networkmanager/vpn_schema.cpp
msgid "Allow compression"
msgstr "Cho phép nén"

#: clients/networkmanager/vpn_schema.cpp
msgid "Incoming only"
msgstr "Chỉ chiều đến"

#: clients/networkmanager/vpn_schema.cpp
msgid "Both ways"
msgstr "Cả hai chiều"

#: clients/networkmanager/vpn_schema.cpp
msgid "No"
msgstr "Không"

