msgid "DHCP Only"
msgstr "Chỉ DHCP"

#: clients/networkmanager/ip_utils.cpp
msgid "Link-Local Only"
msgstr "Chỉ link-local"

#: clients/networkmanager/ip_utils.cpp
msgid "Shared to Other Computers"
msgstr "Chia sẻ cho máy tính khác"

#: clients/networkmanager/ip_utils.cpp
msgid "Left to the System"
msgstr "Để hệ thống quyết định"

#: clients/networkmanager/ip_utils.cpp
#, python-brace-format
msgid "{address} isn't an IPv4 address."
msgstr "{address} không phải là địa chỉ IPv4."

#: clients/networkmanager/ip_utils.cpp
#, python-brace-format
msgid "{address} isn't an IPv6 address."
msgstr "{address} không phải là địa chỉ IPv6."

#: clients/networkmanager/ip_utils.cpp
#, python-brace-format
msgid "{mask} isn't a subnet mask."
msgstr "{mask} không phải là mặt nạ mạng con."

#: clients/networkmanager/ip_utils.cpp
msgid "The prefix length must be a number from 1 to 128."
msgstr "Độ dài tiền tố phải là số từ 1 đến 128."

#: clients/networkmanager/ip_utils.cpp
#, python-brace-format
msgid "{address} isn't a router address."
msgstr "{address} không phải là địa chỉ bộ định tuyến."

#: clients/networkmanager/ip_utils.cpp
msgid "IPv4 name servers need IPv4 set to automatic or manual."
msgstr "Máy chủ tên IPv4 cần đặt IPv4 ở chế độ tự động hoặc thủ công."

#: clients/networkmanager/ip_utils.cpp
msgid "IPv6 name servers need IPv6 set to automatic or manual."
msgstr "Máy chủ tên IPv6 cần đặt IPv6 ở chế độ tự động hoặc thủ công."

#: clients/networkmanager/ip_utils.cpp
#, python-brace-format
msgid "{address} isn't a name server address."
msgstr "{address} không phải là địa chỉ máy chủ tên."

#: clients/networkmanager/ip_utils.cpp
msgid "Fill in the address and subnet mask."
msgstr "Hãy điền địa chỉ và mặt nạ mạng con."

#. TRANSLATORS: a network and the adapter it is on, such as "Home (wlan0)".
#: clients/networkmanager/network_model.cpp
#, python-brace-format
msgid "{name} ({device})"
msgstr "{name} ({device})"

#: clients/networkmanager/network_model.cpp
#, python-brace-format
