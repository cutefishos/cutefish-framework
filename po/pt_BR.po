#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Cannot unblock Bluetooth: {error}"
msgstr "Não é possível desbloquear o Bluetooth: {error}"

#: clients/bluez/manager.cpp
msgid "The device didn't finish pairing in time. Try again."
msgstr "O dispositivo não concluiu o pareamento a tempo. Tente novamente."

#: clients/bluez/manager.cpp
msgid "The system D-Bus connection is unavailable."
msgstr "A conexão com o D-Bus do sistema não está disponível."

#: clients/bluez/manager.cpp
msgid "Bluetooth is blocked by a hardware switch."
msgstr "O Bluetooth está bloqueado por um interruptor físico."

#: clients/bluez/manager.cpp
msgid "The Bluetooth service is unavailable."
msgstr "O serviço de Bluetooth não está disponível."

#: clients/bluez/manager.cpp
msgid "Bluetooth couldn't complete the request."
msgstr "O Bluetooth não conseguiu concluir a solicitação."

#: clients/bluez/manager.cpp
msgid "This device is no longer available."
msgstr "Este dispositivo não está mais disponível."

#: clients/bluez/manager.cpp
msgid "The device is busy. Try again in a moment."
msgstr "O dispositivo está ocupado. Tente novamente em instantes."

#: clients/bluez/manager.cpp
msgid "Bluetooth isn't ready yet. Try again in a moment."
msgstr "O Bluetooth ainda não está pronto. Tente novamente em instantes."

#: clients/bluez/manager.cpp
msgid "This device has no media player."
msgstr "Este dispositivo não tem um reprodutor de mídia."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent: no system bus."
msgstr "Não é possível exportar o agente de pareamento Bluetooth: não há barramento do sistema."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent."
msgstr "Não é possível exportar o agente de pareamento Bluetooth."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "Digite um PIN com 1 a 16 bytes."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "Digite uma chave de acesso com 1 a 6 dígitos."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "Não foi possível conectar a {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "Não foi possível conectar ao dispositivo"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "Não foi possível desconectar {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "Não foi possível desconectar o dispositivo"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "Não foi possível parear com {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "Não foi possível parear com o dispositivo"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "Não foi possível esquecer {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "Não foi possível esquecer o dispositivo"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Tente novamente. Se continuar falhando, desligue o dispositivo e ligue-o de novo."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "O dispositivo não respondeu a tempo. Verifique se ele está ligado e por perto."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "O dispositivo não respondeu. Verifique se ele está ligado, por perto e não conectado a outro dispositivo."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "O dispositivo não reconhece mais este computador. Esqueça o dispositivo e pareie-o novamente."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "Falha no pareamento. Verifique se o código é o mesmo nos dois dispositivos e tente novamente."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "O dispositivo recusou a solicitação."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "O dispositivo recusou a conexão."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "O dispositivo não tem recursos que este computador possa usar."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "O Bluetooth está desativado."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Há dispositivos demais conectados. Desconecte um e tente novamente."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "O dispositivo encerrou a conexão."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "A conexão foi interrompida. Tente novamente."

