#: clients/networkmanager/handler.cpp
msgid "The hotspot could not be started. The Wi-Fi adapter may not support it on this channel or with this password."
msgstr "Não foi possível iniciar o ponto de acesso. O adaptador Wi-Fi pode não ser compatível com isso neste canal ou com esta senha."

#: clients/networkmanager/handler.cpp
msgid "No Wi-Fi adapter can run a hotspot."
msgstr "Nenhum adaptador Wi-Fi pode criar um ponto de acesso."

#: clients/networkmanager/handler.cpp
msgid "No VPN plugin can read this file. Install the one for your VPN, for example network-manager-openvpn for OpenVPN."
msgstr "Nenhum plug-in de VPN consegue ler este arquivo. Instale o da sua VPN, por exemplo network-manager-openvpn para OpenVPN."

#: clients/networkmanager/handler.cpp
msgid "This file isn't a VPN configuration this system can read."
msgstr "Este arquivo não é uma configuração de VPN que este sistema consiga ler."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which reads VPN files, is not installed."
msgstr "O nmcli, que lê arquivos de VPN, não está instalado."

#: clients/networkmanager/handler.cpp
msgid "The private key can't be read, so the file would be incomplete."
msgstr "Não é possível ler a chave privada, então o arquivo ficaria incompleto."

#: clients/networkmanager/handler.cpp
msgid "The file can't be written."
msgstr "Não é possível gravar o arquivo."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which writes VPN files, is not installed."
msgstr "O nmcli, que grava arquivos de VPN, não está instalado."

#: clients/networkmanager/handler.cpp
msgid "The VPN couldn't be written to a file."
msgstr "Não foi possível gravar a VPN em um arquivo."

