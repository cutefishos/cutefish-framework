#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Cannot unblock Bluetooth: {error}"
msgstr "Impossible de débloquer le Bluetooth : {error}"

#: clients/bluez/manager.cpp
msgid "The device didn't finish pairing in time. Try again."
msgstr "L'appareil n'a pas terminé le jumelage à temps. Réessayez."

#: clients/bluez/manager.cpp
msgid "The system D-Bus connection is unavailable."
msgstr "La connexion D-Bus système n'est pas disponible."

#: clients/bluez/manager.cpp
msgid "Bluetooth is blocked by a hardware switch."
msgstr "Le Bluetooth est bloqué par un interrupteur matériel."

#: clients/bluez/manager.cpp
msgid "The Bluetooth service is unavailable."
msgstr "Le service Bluetooth n'est pas disponible."

#: clients/bluez/manager.cpp
msgid "Bluetooth couldn't complete the request."
msgstr "Le Bluetooth n'a pas pu traiter la demande."

#: clients/bluez/manager.cpp
msgid "This device is no longer available."
msgstr "Cet appareil n'est plus disponible."

#: clients/bluez/manager.cpp
msgid "The device is busy. Try again in a moment."
msgstr "L'appareil est occupé. Réessayez dans un instant."

#: clients/bluez/manager.cpp
msgid "Bluetooth isn't ready yet. Try again in a moment."
msgstr "Le Bluetooth n'est pas encore prêt. Réessayez dans un instant."

#: clients/bluez/manager.cpp
msgid "This device has no media player."
msgstr "Cet appareil n'a pas de lecteur multimédia."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent: no system bus."
msgstr "Impossible d'exporter l'agent de jumelage Bluetooth : aucun bus système."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent."
msgstr "Impossible d'exporter l'agent de jumelage Bluetooth."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "Saisissez un code PIN de 1 à 16 octets."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "Saisissez une clé d'accès de 1 à 6 chiffres."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "Impossible de se connecter à {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "Impossible de se connecter à l'appareil"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "Impossible de déconnecter {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "Impossible de déconnecter l'appareil"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "Impossible de jumeler {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "Impossible de jumeler l'appareil"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "Impossible d'oublier {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "Impossible d'oublier l'appareil"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Réessayez. Si l'échec persiste, éteignez puis rallumez l'appareil."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "L'appareil n'a pas répondu à temps. Vérifiez qu'il est allumé et à proximité."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "L'appareil n'a pas répondu. Vérifiez qu'il est allumé, à proximité et qu'il n'est pas connecté à un autre appareil."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "L'appareil ne reconnaît plus cet ordinateur. Oubliez l'appareil, puis jumelez-le à nouveau."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "Le jumelage a échoué. Vérifiez que le code est identique sur les deux appareils, puis réessayez."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "L'appareil a décliné la demande."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "L'appareil a refusé la connexion."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "L'appareil n'offre aucune fonction utilisable par cet ordinateur."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Le Bluetooth est désactivé."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Trop d'appareils sont connectés. Déconnectez-en un, puis réessayez."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "L'appareil a mis fin à la connexion."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "La connexion a été interrompue. Réessayez."

