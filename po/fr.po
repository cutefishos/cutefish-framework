#: clients/networkmanager/handler.cpp
msgid "The hotspot could not be started. The Wi-Fi adapter may not support it on this channel or with this password."
msgstr "Impossible de démarrer le point d'accès. L'adaptateur Wi-Fi ne le prend peut-être pas en charge sur ce canal ou avec ce mot de passe."

#: clients/networkmanager/handler.cpp
msgid "No Wi-Fi adapter can run a hotspot."
msgstr "Aucun adaptateur Wi-Fi ne peut créer de point d'accès."

#: clients/networkmanager/handler.cpp
msgid "No VPN plugin can read this file. Install the one for your VPN, for example network-manager-openvpn for OpenVPN."
msgstr "Aucun module VPN ne peut lire ce fichier. Installez celui de votre VPN, par exemple network-manager-openvpn pour OpenVPN."

#: clients/networkmanager/handler.cpp
msgid "This file isn't a VPN configuration this system can read."
msgstr "Ce fichier n'est pas une configuration VPN lisible par ce système."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which reads VPN files, is not installed."
msgstr "nmcli, qui lit les fichiers VPN, n'est pas installé."

#: clients/networkmanager/handler.cpp
msgid "The private key can't be read, so the file would be incomplete."
msgstr "La clé privée est illisible, le fichier serait donc incomplet."

#: clients/networkmanager/handler.cpp
msgid "The file can't be written."
msgstr "Impossible d'écrire le fichier."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which writes VPN files, is not installed."
msgstr "nmcli, qui écrit les fichiers VPN, n'est pas installé."

#: clients/networkmanager/handler.cpp
msgid "The VPN couldn't be written to a file."
msgstr "Impossible d'enregistrer le VPN dans un fichier."

