#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Cannot unblock Bluetooth: {error}"
msgstr "Bluetooth nelze odblokovat: {error}"

#: clients/bluez/manager.cpp
msgid "The device didn't finish pairing in time. Try again."
msgstr "Zařízení nedokončilo párování včas. Zkuste to znovu."

#: clients/bluez/manager.cpp
msgid "The system D-Bus connection is unavailable."
msgstr "Připojení k systémové sběrnici D-Bus není dostupné."

#: clients/bluez/manager.cpp
msgid "Bluetooth is blocked by a hardware switch."
msgstr "Bluetooth je zablokováno hardwarovým přepínačem."

#: clients/bluez/manager.cpp
msgid "The Bluetooth service is unavailable."
msgstr "Služba Bluetooth není dostupná."

#: clients/bluez/manager.cpp
msgid "Bluetooth couldn't complete the request."
msgstr "Bluetooth nemohlo dokončit požadavek."

#: clients/bluez/manager.cpp
msgid "This device is no longer available."
msgstr "Toto zařízení již není dostupné."

#: clients/bluez/manager.cpp
msgid "The device is busy. Try again in a moment."
msgstr "Zařízení je zaneprázdněno. Zkuste to za chvíli znovu."

#: clients/bluez/manager.cpp
msgid "Bluetooth isn't ready yet. Try again in a moment."
msgstr "Bluetooth ještě není připraveno. Zkuste to za chvíli znovu."

#: clients/bluez/manager.cpp
msgid "This device has no media player."
msgstr "Toto zařízení nemá žádný přehrávač médií."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent: no system bus."
msgstr "Agenta párování Bluetooth nelze zpřístupnit: chybí systémová sběrnice."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent."
msgstr "Agenta párování Bluetooth nelze zpřístupnit."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "Zadejte PIN o délce 1–16 bajtů."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "Zadejte přístupový klíč o délce 1–6 číslic."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "K zařízení {device} se nelze připojit"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "K zařízení se nelze připojit"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "Zařízení {device} nelze odpojit"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "Zařízení nelze odpojit"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "Se zařízením {device} nelze spárovat"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "Se zařízením nelze spárovat"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "Zařízení {device} nelze zapomenout"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "Zařízení nelze zapomenout"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Zkuste to znovu. Pokud se to bude opakovat, zařízení vypněte a znovu zapněte."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "Zařízení neodpovědělo včas. Ujistěte se, že je zapnuté a v blízkosti."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "Zařízení neodpovědělo. Ujistěte se, že je zapnuté, v blízkosti a není připojené k jinému zařízení."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "Zařízení již tento počítač nerozpoznává. Zapomeňte zařízení a spárujte ho znovu."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "Párování selhalo. Ujistěte se, že se kód na obou zařízeních shoduje, a zkuste to znovu."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "Zařízení žádost odmítlo."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "Zařízení odmítlo připojení."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "Zařízení nemá žádné funkce, které by tento počítač mohl použít."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Bluetooth je vypnuto."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Je připojeno příliš mnoho zařízení. Jedno odpojte a zkuste to znovu."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "Zařízení ukončilo připojení."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "Připojení bylo přerušeno. Zkuste to znovu."

