#: clients/networkmanager/handler.cpp
msgid "The hotspot could not be started. The Wi-Fi adapter may not support it on this channel or with this password."
msgstr "Hotspot nelze spustit. Adaptér Wi-Fi ho na tomto kanálu nebo s tímto heslem možná nepodporuje."

#: clients/networkmanager/handler.cpp
msgid "No Wi-Fi adapter can run a hotspot."
msgstr "Žádný adaptér Wi-Fi nedokáže provozovat hotspot."

#: clients/networkmanager/handler.cpp
msgid "No VPN plugin can read this file. Install the one for your VPN, for example network-manager-openvpn for OpenVPN."
msgstr "Tento soubor neumí načíst žádný zásuvný modul VPN. Nainstalujte modul pro svou VPN, například network-manager-openvpn pro OpenVPN."

#: clients/networkmanager/handler.cpp
msgid "This file isn't a VPN configuration this system can read."
msgstr "Tento soubor není konfigurace VPN, kterou tento systém umí načíst."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which reads VPN files, is not installed."
msgstr "Program nmcli, který načítá soubory VPN, není nainstalován."

#: clients/networkmanager/handler.cpp
msgid "The private key can't be read, so the file would be incomplete."
msgstr "Soukromý klíč nelze přečíst, takže by soubor byl neúplný."

#: clients/networkmanager/handler.cpp
msgid "The file can't be written."
msgstr "Soubor nelze zapsat."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which writes VPN files, is not installed."
msgstr "Program nmcli, který zapisuje soubory VPN, není nainstalován."

#: clients/networkmanager/handler.cpp
msgid "The VPN couldn't be written to a file."
msgstr "VPN nelze zapsat do souboru."

