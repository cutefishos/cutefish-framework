#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Cannot unblock Bluetooth: {error}"
msgstr "Nie można odblokować Bluetooth: {error}"

#: clients/bluez/manager.cpp
msgid "The device didn't finish pairing in time. Try again."
msgstr "Urządzenie nie zakończyło parowania na czas. Spróbuj ponownie."

#: clients/bluez/manager.cpp
msgid "The system D-Bus connection is unavailable."
msgstr "Połączenie z systemową magistralą D-Bus jest niedostępne."

#: clients/bluez/manager.cpp
msgid "Bluetooth is blocked by a hardware switch."
msgstr "Bluetooth jest zablokowany przełącznikiem sprzętowym."

#: clients/bluez/manager.cpp
msgid "The Bluetooth service is unavailable."
msgstr "Usługa Bluetooth jest niedostępna."

#: clients/bluez/manager.cpp
msgid "Bluetooth couldn't complete the request."
msgstr "Bluetooth nie mógł wykonać żądania."

#: clients/bluez/manager.cpp
msgid "This device is no longer available."
msgstr "To urządzenie nie jest już dostępne."

#: clients/bluez/manager.cpp
msgid "The device is busy. Try again in a moment."
msgstr "Urządzenie jest zajęte. Spróbuj ponownie za chwilę."

#: clients/bluez/manager.cpp
msgid "Bluetooth isn't ready yet. Try again in a moment."
msgstr "Bluetooth nie jest jeszcze gotowy. Spróbuj ponownie za chwilę."

#: clients/bluez/manager.cpp
msgid "This device has no media player."
msgstr "To urządzenie nie ma odtwarzacza multimediów."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent: no system bus."
msgstr "Nie można udostępnić agenta parowania Bluetooth: brak magistrali systemowej."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent."
msgstr "Nie można udostępnić agenta parowania Bluetooth."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "Wprowadź kod PIN o długości od 1 do 16 bajtów."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "Wprowadź klucz dostępu składający się z 1–6 cyfr."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "Nie można połączyć z {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "Nie można połączyć z urządzeniem"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "Nie można rozłączyć {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "Nie można rozłączyć urządzenia"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "Nie można sparować z {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "Nie można sparować z urządzeniem"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "Nie można zapomnieć {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "Nie można zapomnieć urządzenia"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Spróbuj ponownie. Jeśli problem będzie się powtarzał, wyłącz i ponownie włącz urządzenie."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "Urządzenie nie odpowiedziało na czas. Upewnij się, że jest włączone i znajduje się w pobliżu."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "Urządzenie nie odpowiada. Upewnij się, że jest włączone, znajduje się w pobliżu i nie jest połączone z innym urządzeniem."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "Urządzenie już nie rozpoznaje tego komputera. Zapomnij urządzenie i sparuj je ponownie."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "Parowanie nie powiodło się. Upewnij się, że kod na obu urządzeniach jest taki sam, i spróbuj ponownie."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "Urządzenie odrzuciło żądanie."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "Urządzenie odmówiło połączenia."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "Urządzenie nie ma funkcji, z których ten komputer może korzystać."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Bluetooth jest wyłączony."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Połączono zbyt wiele urządzeń. Rozłącz jedno i spróbuj ponownie."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "Urządzenie zakończyło połączenie."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "Połączenie zostało przerwane. Spróbuj ponownie."

#: clients/display/display_client.cpp
msgid "The display operation timed out."
msgstr "Upłynął limit czasu operacji na ekranie."

#: clients/display/display_client.cpp
msgid "The display service restarted."
msgstr "Usługa ekranów została ponownie uruchomiona."

#: clients/display/display_client.cpp
msgid "Unexpected display state."
msgstr "Nieoczekiwany stan ekranu."

#: clients/display/output_model.cpp
msgid "Built-in Display"
msgstr "Wbudowany ekran"

#. TRANSLATORS: a monitor and the port it is plugged into, such as "DELL U2720Q (DP-1)".
#: clients/display/output_model.cpp
#, python-brace-format
msgid "{name} ({connector})"
msgstr "{name} ({connector})"

#. TRANSLATORS: a screen resolution in pixels, such as "1920 × 1080".
#: clients/display/output_model.cpp
#, python-brace-format
msgid "{width} × {height}"
msgstr "{width} × {height}"

#. TRANSLATORS: a refresh rate, such as "60.00 Hz".
#: clients/display/output_model.cpp
#, python-brace-format
msgid "{rate} Hz"
msgstr "{rate} Hz"

#. TRANSLATORS: the choice that shows other content on this display instead of mirroring another one.
#: clients/display/output_model.cpp
msgid "Extend"
msgstr "Rozszerz"

#: clients/display/screen.cpp
msgid "The display service is unavailable."
msgstr "Usługa ekranów jest niedostępna."

#: clients/display/screen.cpp
msgid "Displays changed. The previous draft was discarded."
msgstr "Ekrany się zmieniły. Poprzedni szkic został odrzucony."

#: clients/networkmanager/handler.cpp
msgid "The hotspot could not be started. The Wi-Fi adapter may not support it on this channel or with this password."
msgstr "Nie można uruchomić hotspotu. Karta Wi-Fi może nie obsługiwać go na tym kanale lub z tym hasłem."

#: clients/networkmanager/handler.cpp
msgid "No Wi-Fi adapter can run a hotspot."
msgstr "Żadna karta Wi-Fi nie może obsługiwać hotspotu."

#: clients/networkmanager/handler.cpp
msgid "No VPN plugin can read this file. Install the one for your VPN, for example network-manager-openvpn for OpenVPN."
msgstr "Żadna wtyczka VPN nie może odczytać tego pliku. Zainstaluj wtyczkę dla swojej sieci VPN, na przykład network-manager-openvpn dla OpenVPN."

#: clients/networkmanager/handler.cpp
msgid "This file isn't a VPN configuration this system can read."
msgstr "Ten plik nie jest konfiguracją VPN, którą ten system może odczytać."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which reads VPN files, is not installed."
msgstr "Program nmcli, który odczytuje pliki VPN, nie jest zainstalowany."

#: clients/networkmanager/handler.cpp
msgid "The private key can't be read, so the file would be incomplete."
msgstr "Nie można odczytać klucza prywatnego, więc plik byłby niekompletny."

#: clients/networkmanager/handler.cpp
msgid "The file can't be written."
msgstr "Nie można zapisać pliku."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which writes VPN files, is not installed."
msgstr "Program nmcli, który zapisuje pliki VPN, nie jest zainstalowany."

#: clients/networkmanager/handler.cpp
msgid "The VPN couldn't be written to a file."
msgstr "Nie można zapisać VPN do pliku."

