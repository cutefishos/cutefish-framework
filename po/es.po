#: clients/networkmanager/handler.cpp
msgid "The hotspot could not be started. The Wi-Fi adapter may not support it on this channel or with this password."
msgstr "No se pudo iniciar el punto de acceso. Es posible que el adaptador Wi-Fi no lo admita en este canal o con esta contraseña."

#: clients/networkmanager/handler.cpp
msgid "No Wi-Fi adapter can run a hotspot."
msgstr "Ningún adaptador Wi-Fi puede crear un punto de acceso."

#: clients/networkmanager/handler.cpp
msgid "No VPN plugin can read this file. Install the one for your VPN, for example network-manager-openvpn for OpenVPN."
msgstr "Ningún complemento de VPN puede leer este archivo. Instala el de tu VPN, por ejemplo network-manager-openvpn para OpenVPN."

#: clients/networkmanager/handler.cpp
msgid "This file isn't a VPN configuration this system can read."
msgstr "Este archivo no es una configuración de VPN que este sistema pueda leer."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which reads VPN files, is not installed."
msgstr "nmcli, que lee los archivos de VPN, no está instalado."

#: clients/networkmanager/handler.cpp
msgid "The private key can't be read, so the file would be incomplete."
msgstr "No se puede leer la clave privada, por lo que el archivo quedaría incompleto."

#: clients/networkmanager/handler.cpp
msgid "The file can't be written."
msgstr "No se puede escribir el archivo."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which writes VPN files, is not installed."
msgstr "nmcli, que escribe los archivos de VPN, no está instalado."

#: clients/networkmanager/handler.cpp
msgid "The VPN couldn't be written to a file."
msgstr "No se pudo escribir la VPN en un archivo."

