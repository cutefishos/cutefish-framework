#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Cannot unblock Bluetooth: {error}"
msgstr "No se puede desbloquear Bluetooth: {error}"

#: clients/bluez/manager.cpp
msgid "The device didn't finish pairing in time. Try again."
msgstr "El dispositivo no terminó de vincularse a tiempo. Inténtalo de nuevo."

#: clients/bluez/manager.cpp
msgid "The system D-Bus connection is unavailable."
msgstr "La conexión de D-Bus del sistema no está disponible."

#: clients/bluez/manager.cpp
msgid "Bluetooth is blocked by a hardware switch."
msgstr "Bluetooth está bloqueado por un interruptor de hardware."

#: clients/bluez/manager.cpp
msgid "The Bluetooth service is unavailable."
msgstr "El servicio de Bluetooth no está disponible."

#: clients/bluez/manager.cpp
msgid "Bluetooth couldn't complete the request."
msgstr "Bluetooth no pudo completar la solicitud."

#: clients/bluez/manager.cpp
msgid "This device is no longer available."
msgstr "Este dispositivo ya no está disponible."

#: clients/bluez/manager.cpp
msgid "The device is busy. Try again in a moment."
msgstr "El dispositivo está ocupado. Inténtalo de nuevo en un momento."

#: clients/bluez/manager.cpp
msgid "Bluetooth isn't ready yet. Try again in a moment."
msgstr "Bluetooth aún no está listo. Inténtalo de nuevo en un momento."

#: clients/bluez/manager.cpp
msgid "This device has no media player."
msgstr "Este dispositivo no tiene reproductor multimedia."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent: no system bus."
msgstr "No se puede exportar el agente de vinculación Bluetooth: no hay bus del sistema."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent."
msgstr "No se puede exportar el agente de vinculación Bluetooth."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "Escribe un PIN de 1 a 16 bytes."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "Escribe una clave de acceso de 1 a 6 dígitos."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "No se pudo conectar con {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "No se pudo conectar con el dispositivo"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "No se pudo desconectar {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "No se pudo desconectar el dispositivo"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "No se pudo vincular con {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "No se pudo vincular con el dispositivo"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "No se pudo olvidar {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "No se pudo olvidar el dispositivo"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Inténtalo de nuevo. Si sigue fallando, apaga el dispositivo y vuelve a encenderlo."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "El dispositivo no respondió a tiempo. Asegúrate de que esté encendido y cerca."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "El dispositivo no respondió. Asegúrate de que esté encendido, cerca y no conectado a otro dispositivo."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "El dispositivo ya no reconoce esta computadora. Olvida el dispositivo y vuelve a vincularlo."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "La vinculación falló. Asegúrate de que el código coincida en ambos dispositivos e inténtalo de nuevo."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "El dispositivo rechazó la solicitud."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "El dispositivo rechazó la conexión."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "El dispositivo no tiene funciones que esta computadora pueda usar."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Bluetooth está desactivado."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Hay demasiados dispositivos conectados. Desconecta uno e inténtalo de nuevo."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "El dispositivo finalizó la conexión."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "La conexión se interrumpió. Inténtalo de nuevo."

