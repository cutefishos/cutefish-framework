#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Cannot unblock Bluetooth: {error}"
msgstr "Bluetooth kann nicht entsperrt werden: {error}"

#: clients/bluez/manager.cpp
msgid "The device didn't finish pairing in time. Try again."
msgstr "Das Gerät hat das Koppeln nicht rechtzeitig abgeschlossen. Versuchen Sie es erneut."

#: clients/bluez/manager.cpp
msgid "The system D-Bus connection is unavailable."
msgstr "Die System-D-Bus-Verbindung ist nicht verfügbar."

#: clients/bluez/manager.cpp
msgid "Bluetooth is blocked by a hardware switch."
msgstr "Bluetooth ist durch einen Hardwareschalter blockiert."

#: clients/bluez/manager.cpp
msgid "The Bluetooth service is unavailable."
msgstr "Der Bluetooth-Dienst ist nicht verfügbar."

#: clients/bluez/manager.cpp
msgid "Bluetooth couldn't complete the request."
msgstr "Bluetooth konnte die Anfrage nicht ausführen."

#: clients/bluez/manager.cpp
msgid "This device is no longer available."
msgstr "Dieses Gerät ist nicht mehr verfügbar."

#: clients/bluez/manager.cpp
msgid "The device is busy. Try again in a moment."
msgstr "Das Gerät ist belegt. Versuchen Sie es gleich noch einmal."

