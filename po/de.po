msgid "Cannot export the Bluetooth pairing agent."
msgstr "Der Bluetooth-Kopplungsagent kann nicht bereitgestellt werden."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "Geben Sie eine PIN mit 1–16 Byte ein."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "Geben Sie einen Code mit 1–6 Ziffern ein."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "Verbindung mit {device} fehlgeschlagen"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "Verbindung mit dem Gerät fehlgeschlagen"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "{device} konnte nicht getrennt werden"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "Das Gerät konnte nicht getrennt werden"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "Koppeln mit {device} fehlgeschlagen"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "Koppeln mit dem Gerät fehlgeschlagen"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "{device} konnte nicht entfernt werden"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "Das Gerät konnte nicht entfernt werden"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Versuchen Sie es erneut. Wenn es weiterhin fehlschlägt, schalten Sie das Gerät aus und wieder ein."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "Das Gerät hat nicht rechtzeitig geantwortet. Stellen Sie sicher, dass es eingeschaltet und in der Nähe ist."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "Das Gerät antwortet nicht. Stellen Sie sicher, dass es eingeschaltet, in der Nähe und nicht mit einem anderen Gerät verbunden ist."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "Das Gerät erkennt diesen Computer nicht mehr. Entfernen Sie das Gerät und koppeln Sie es erneut."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "Koppeln fehlgeschlagen. Stellen Sie sicher, dass der Code auf beiden Geräten übereinstimmt, und versuchen Sie es erneut."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "Das Gerät hat die Anfrage abgelehnt."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "Das Gerät hat die Verbindung verweigert."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "Das Gerät hat keine Funktionen, die dieser Computer nutzen kann."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Bluetooth ist ausgeschaltet."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Zu viele Geräte sind verbunden. Trennen Sie eines und versuchen Sie es erneut."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "Das Gerät hat die Verbindung beendet."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "Die Verbindung wurde unterbrochen. Versuchen Sie es erneut."

