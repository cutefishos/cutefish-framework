msgid "This device has no media player."
msgstr "Dieses Gerät hat keinen Medienplayer."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent: no system bus."
msgstr "Der Bluetooth-Kopplungsagent kann nicht bereitgestellt werden: kein Systembus."

