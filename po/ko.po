msgid "CA certificate"
msgstr "CA 인증서"

#: clients/networkmanager/vpn_schema.cpp
msgid "User certificate"
msgstr "사용자 인증서"

#: clients/networkmanager/vpn_schema.cpp
msgid "Private key"
msgstr "개인 키"

#: clients/networkmanager/vpn_schema.cpp
msgid "Private key password"
msgstr "개인 키 암호"

#: clients/networkmanager/vpn_schema.cpp
msgid "Key direction"
msgstr "키 방향"

#: clients/networkmanager/vpn_schema.cpp
