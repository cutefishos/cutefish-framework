msgstr "가능한 경우"

#: clients/networkmanager/vpn_schema.cpp
msgid "Always"
msgstr "항상"

#: clients/networkmanager/vpn_schema.cpp
msgid "Renegotiate every (seconds)"
msgstr "재협상 간격(초)"

#: clients/networkmanager/vpn_schema.cpp
msgid "Compression"
msgstr "압축"

#: clients/networkmanager/vpn_schema.cpp
msgid "Allow compression"
msgstr "압축 허용"

#: clients/networkmanager/vpn_schema.cpp
msgid "Incoming only"
msgstr "수신만"

#: clients/networkmanager/vpn_schema.cpp
msgid "Both ways"
msgstr "양방향"

#: clients/networkmanager/vpn_schema.cpp
msgid "No"
msgstr "아니요"

#: clients/networkmanager/vpn_schema.cpp
msgid "Pick servers at random"
msgstr "무작위로 서버 선택"

#: clients/networkmanager/vpn_schema.cpp
