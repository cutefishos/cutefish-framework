msgstr "데이터 암호 알고리즘 대체"

#: clients/networkmanager/vpn_schema.cpp
msgid "Disable cipher negotiation"
msgstr "암호 알고리즘 협상 비활성화"

#: clients/networkmanager/vpn_schema.cpp
msgid "HMAC authentication"
msgstr "HMAC 인증"

#: clients/networkmanager/vpn_schema.cpp
msgid "Key size (bits)"
msgstr "키 크기(비트)"

#: clients/networkmanager/vpn_schema.cpp
msgid "Revocation list file"
msgstr "인증서 해지 목록 파일"

#: clients/networkmanager/vpn_schema.cpp
msgid "Revocation list directory"
msgstr "인증서 해지 목록 디렉토리"

#: clients/networkmanager/vpn_schema.cpp
