#: clients/accounts/accounts_manager.cpp
msgid "The accounts service cannot be reached"
msgstr "계정 서비스에 연결할 수 없습니다"

#: clients/accounts/accounts_manager.cpp
msgid "Created user was removed"
msgstr "생성된 사용자가 제거되었습니다"

#. TRANSLATORS: a sound setting that failed, then why, such as "Set device volume: Permission denied".
#: clients/audio/backend.cpp
#, python-brace-format
msgid "{operation}: {error}"
msgstr "{operation}: {error}"

#: clients/audio/backend.cpp
msgid "Set device volume"
msgstr "장치 음량 설정"

#: clients/audio/backend.cpp
msgid "Set audio properties"
msgstr "오디오 속성 설정"

#: clients/audio/backend.cpp
msgid "Set default device"
msgstr "기본 장치 설정"

#: clients/audio/backend.cpp
msgid "Set device profile"
msgstr "장치 프로필 설정"

#: clients/audio/backend.cpp
msgid "Set device route"
msgstr "장치 경로 설정"

#: clients/audio/backend.cpp
msgid "Move audio stream"
msgstr "오디오 스트림 이동"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Cannot unblock Bluetooth: {error}"
msgstr "Bluetooth 차단을 해제할 수 없습니다: {error}"

#: clients/bluez/manager.cpp
msgid "The device didn't finish pairing in time. Try again."
msgstr "장치가 제시간에 페어링을 완료하지 못했습니다. 다시 시도하십시오."

#: clients/bluez/manager.cpp
msgid "The system D-Bus connection is unavailable."
msgstr "시스템 D-Bus 연결을 사용할 수 없습니다."

#: clients/bluez/manager.cpp
msgid "Bluetooth is blocked by a hardware switch."
msgstr "Bluetooth가 하드웨어 스위치로 차단되어 있습니다."

#: clients/bluez/manager.cpp
msgid "The Bluetooth service is unavailable."
msgstr "Bluetooth 서비스를 사용할 수 없습니다."

#: clients/bluez/manager.cpp
msgid "Bluetooth couldn't complete the request."
msgstr "Bluetooth에서 요청을 완료하지 못했습니다."

#: clients/bluez/manager.cpp
msgid "This device is no longer available."
msgstr "이 장치는 더 이상 사용할 수 없습니다."

#: clients/bluez/manager.cpp
msgid "The device is busy. Try again in a moment."
msgstr "장치가 사용 중입니다. 잠시 후 다시 시도하십시오."

#: clients/bluez/manager.cpp
msgid "Bluetooth isn't ready yet. Try again in a moment."
msgstr "Bluetooth가 아직 준비되지 않았습니다. 잠시 후 다시 시도하십시오."

#: clients/bluez/manager.cpp
msgid "This device has no media player."
msgstr "이 장치에는 미디어 플레이어가 없습니다."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent: no system bus."
msgstr "Bluetooth 페어링 에이전트를 내보낼 수 없습니다: 시스템 버스가 없습니다."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent."
msgstr "Bluetooth 페어링 에이전트를 내보낼 수 없습니다."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "1–16바이트의 PIN을 입력하십시오."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "1–6자리 숫자의 패스키를 입력하십시오."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "{device}에 연결할 수 없습니다"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "장치에 연결할 수 없습니다"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "{device}의 연결을 해제할 수 없습니다"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "장치의 연결을 해제할 수 없습니다"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "{device} 장치와 페어링할 수 없습니다"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "장치와 페어링할 수 없습니다"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "{device}의 등록을 해제할 수 없습니다"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "장치의 등록을 해제할 수 없습니다"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "다시 시도하십시오. 계속 실패하면 장치를 껐다가 다시 켜십시오."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "장치가 제시간에 응답하지 않았습니다. 장치가 켜져 있고 가까이 있는지 확인하십시오."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "장치가 응답하지 않았습니다. 장치가 켜져 있고 가까이 있으며 다른 장치에 연결되어 있지 않은지 확인하십시오."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "장치가 더 이상 이 컴퓨터를 인식하지 못합니다. 장치 등록을 해제한 다음 다시 페어링하십시오."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "페어링에 실패했습니다. 두 장치의 코드가 일치하는지 확인하고 다시 시도하십시오."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "장치가 요청을 거부했습니다."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "장치가 연결을 거부했습니다."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "이 장치에는 이 컴퓨터가 사용할 수 있는 기능이 없습니다."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Bluetooth가 꺼져 있습니다."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "연결된 장치가 너무 많습니다. 하나의 연결을 해제하고 다시 시도하십시오."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "장치가 연결을 종료했습니다."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "연결이 중단되었습니다. 다시 시도하십시오."

#: clients/display/display_client.cpp
msgid "The display operation timed out."
msgstr "디스플레이 작업 시간이 초과되었습니다."

#: clients/display/display_client.cpp
msgid "The display service restarted."
msgstr "디스플레이 서비스가 다시 시작되었습니다."

#: clients/display/display_client.cpp
msgid "Unexpected display state."
msgstr "예상치 못한 디스플레이 상태입니다."

#: clients/display/output_model.cpp
msgid "Built-in Display"
msgstr "내장 디스플레이"

#. TRANSLATORS: a monitor and the port it is plugged into, such as "DELL U2720Q (DP-1)".
#: clients/display/output_model.cpp
#, python-brace-format
msgid "{name} ({connector})"
msgstr "{name}({connector})"

#. TRANSLATORS: a screen resolution in pixels, such as "1920 × 1080".
#: clients/display/output_model.cpp
#, python-brace-format
msgid "{width} × {height}"
msgstr "{width} × {height}"

#. TRANSLATORS: a refresh rate, such as "60.00 Hz".
#: clients/display/output_model.cpp
#, python-brace-format
msgid "{rate} Hz"
msgstr "{rate}Hz"

#. TRANSLATORS: the choice that shows other content on this display instead of mirroring another one.
#: clients/display/output_model.cpp
msgid "Extend"
msgstr "확장"

#: clients/display/screen.cpp
msgid "The display service is unavailable."
msgstr "디스플레이 서비스를 사용할 수 없습니다."

#: clients/display/screen.cpp
msgid "Displays changed. The previous draft was discarded."
msgstr "디스플레이가 변경되었습니다. 이전 초안은 폐기되었습니다."

#: clients/networkmanager/handler.cpp
msgid "The hotspot could not be started. The Wi-Fi adapter may not support it on this channel or with this password."
msgstr "핫스팟을 시작할 수 없습니다. Wi-Fi 어댑터가 이 채널이나 이 암호로는 핫스팟을 지원하지 않을 수 있습니다."

#: clients/networkmanager/handler.cpp
msgid "No Wi-Fi adapter can run a hotspot."
msgstr "핫스팟을 실행할 수 있는 Wi-Fi 어댑터가 없습니다."

#: clients/networkmanager/handler.cpp
msgid "No VPN plugin can read this file. Install the one for your VPN, for example network-manager-openvpn for OpenVPN."
msgstr "이 파일을 읽을 수 있는 VPN 플러그인이 없습니다. 사용하는 VPN용 플러그인을 설치하십시오(예: OpenVPN용 network-manager-openvpn)."

#: clients/networkmanager/handler.cpp
msgid "This file isn't a VPN configuration this system can read."
msgstr "이 파일은 이 시스템에서 읽을 수 있는 VPN 구성이 아닙니다."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which reads VPN files, is not installed."
msgstr "VPN 파일을 읽는 nmcli가 설치되어 있지 않습니다."

#: clients/networkmanager/handler.cpp
msgid "The private key can't be read, so the file would be incomplete."
msgstr "개인 키를 읽을 수 없어 파일이 불완전해집니다."

#: clients/networkmanager/handler.cpp
msgid "The file can't be written."
msgstr "파일을 쓸 수 없습니다."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which writes VPN files, is not installed."
msgstr "VPN 파일을 쓰는 nmcli가 설치되어 있지 않습니다."

#: clients/networkmanager/handler.cpp
msgid "The VPN couldn't be written to a file."
msgstr "VPN을 파일로 쓸 수 없습니다."

#: clients/networkmanager/ip_utils.cpp
msgid "Automatic (DHCP)"
msgstr "자동(DHCP)"

#: clients/networkmanager/ip_utils.cpp clients/networkmanager/vpn_schema.cpp
msgid "Automatic"
msgstr "자동"

#: clients/networkmanager/ip_utils.cpp
msgid "Manual"
msgstr "수동"

#: clients/networkmanager/ip_utils.cpp clients/networkmanager/vpn_schema.cpp
msgid "Off"
msgstr "사용 안 함"

#: clients/networkmanager/ip_utils.cpp
msgid "DHCP Only"
msgstr "DHCP만"

#: clients/networkmanager/ip_utils.cpp
msgid "Link-Local Only"
msgstr "링크 로컬만"

#: clients/networkmanager/ip_utils.cpp
msgid "Shared to Other Computers"
msgstr "다른 컴퓨터와 공유"

#: clients/networkmanager/ip_utils.cpp
msgid "Left to the System"
msgstr "시스템에 맡김"

#: clients/networkmanager/ip_utils.cpp
#, python-brace-format
msgid "{address} isn't an IPv4 address."
msgstr "IPv4 주소가 아닙니다: {address}"

#: clients/networkmanager/ip_utils.cpp
#, python-brace-format
msgid "{address} isn't an IPv6 address."
msgstr "IPv6 주소가 아닙니다: {address}"

#: clients/networkmanager/ip_utils.cpp
#, python-brace-format
msgid "{mask} isn't a subnet mask."
msgstr "서브넷 마스크가 아닙니다: {mask}"

#: clients/networkmanager/ip_utils.cpp
msgid "The prefix length must be a number from 1 to 128."
msgstr "접두사 길이는 1에서 128 사이의 숫자여야 합니다."

#: clients/networkmanager/ip_utils.cpp
#, python-brace-format
msgid "{address} isn't a router address."
msgstr "라우터 주소가 아닙니다: {address}"

#: clients/networkmanager/ip_utils.cpp
msgid "IPv4 name servers need IPv4 set to automatic or manual."
msgstr "IPv4 이름 서버를 사용하려면 IPv4를 자동 또는 수동으로 설정해야 합니다."

#: clients/networkmanager/ip_utils.cpp
msgid "IPv6 name servers need IPv6 set to automatic or manual."
msgstr "IPv6 이름 서버를 사용하려면 IPv6를 자동 또는 수동으로 설정해야 합니다."

#: clients/networkmanager/ip_utils.cpp
#, python-brace-format
msgid "{address} isn't a name server address."
msgstr "이름 서버 주소가 아닙니다: {address}"

#: clients/networkmanager/ip_utils.cpp
msgid "Fill in the address and subnet mask."
msgstr "주소와 서브넷 마스크를 입력하십시오."

#. TRANSLATORS: a network and the adapter it is on, such as "Home (wlan0)".
#: clients/networkmanager/network_model.cpp
#, python-brace-format
msgid "{name} ({device})"
msgstr "{name}({device})"

#: clients/networkmanager/network_model.cpp
#, python-brace-format
msgid "Install {package} to use this VPN."
msgstr "이 VPN을 사용하려면 {package} 패키지를 설치하십시오."

#: clients/networkmanager/network_model.cpp
msgid "Signing in to OpenConnect VPNs isn't supported yet."
msgstr "OpenConnect VPN 로그인은 아직 지원되지 않습니다."

