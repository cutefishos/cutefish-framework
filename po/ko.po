msgstr "없음"

#: clients/networkmanager/vpn_schema.cpp
msgid "Remote IP address"
msgstr "원격 IP 주소"

#: clients/networkmanager/vpn_schema.cpp
msgid "Local IP address"
msgstr "로컬 IP 주소"

#: clients/networkmanager/vpn_schema.cpp
msgid "General"
msgstr "일반"

#: clients/networkmanager/vpn_schema.cpp
msgid "Port"
msgstr "포트"

#: clients/networkmanager/vpn_schema.cpp
msgid "Use TCP"
msgstr "TCP 사용"

#: clients/networkmanager/vpn_schema.cpp
msgid "Device type"
msgstr "장치 유형"

#: clients/networkmanager/vpn_schema.cpp
msgid "Device name"
msgstr "장치 이름"

#: clients/networkmanager/vpn_schema.cpp
