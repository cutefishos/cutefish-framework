#: clients/networkmanager/handler.cpp
msgid "The hotspot could not be started. The Wi-Fi adapter may not support it on this channel or with this password."
msgstr "Impossibile avviare l’hotspot. L’adattatore Wi-Fi potrebbe non supportarlo su questo canale o con questa password."

#: clients/networkmanager/handler.cpp
msgid "No Wi-Fi adapter can run a hotspot."
msgstr "Nessun adattatore Wi-Fi può creare un hotspot."

#: clients/networkmanager/handler.cpp
msgid "No VPN plugin can read this file. Install the one for your VPN, for example network-manager-openvpn for OpenVPN."
msgstr "Nessun plugin VPN può leggere questo file. Installa quello della tua VPN, ad esempio network-manager-openvpn per OpenVPN."

#: clients/networkmanager/handler.cpp
msgid "This file isn't a VPN configuration this system can read."
msgstr "Questo file non è una configurazione VPN leggibile da questo sistema."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which reads VPN files, is not installed."
msgstr "nmcli, che legge i file VPN, non è installato."

#: clients/networkmanager/handler.cpp
msgid "The private key can't be read, so the file would be incomplete."
msgstr "Impossibile leggere la chiave privata, quindi il file sarebbe incompleto."

#: clients/networkmanager/handler.cpp
msgid "The file can't be written."
msgstr "Impossibile scrivere il file."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which writes VPN files, is not installed."
msgstr "nmcli, che scrive i file VPN, non è installato."

#: clients/networkmanager/handler.cpp
msgid "The VPN couldn't be written to a file."
msgstr "Impossibile scrivere la VPN in un file."

