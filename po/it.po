#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Cannot unblock Bluetooth: {error}"
msgstr "Impossibile sbloccare il Bluetooth: {error}"

#: clients/bluez/manager.cpp
msgid "The device didn't finish pairing in time. Try again."
msgstr "Il dispositivo non ha completato l’abbinamento in tempo. Riprova."

#: clients/bluez/manager.cpp
msgid "The system D-Bus connection is unavailable."
msgstr "La connessione D-Bus di sistema non è disponibile."

#: clients/bluez/manager.cpp
msgid "Bluetooth is blocked by a hardware switch."
msgstr "Il Bluetooth è bloccato da un interruttore hardware."

#: clients/bluez/manager.cpp
msgid "The Bluetooth service is unavailable."
msgstr "Il servizio Bluetooth non è disponibile."

#: clients/bluez/manager.cpp
msgid "Bluetooth couldn't complete the request."
msgstr "Il Bluetooth non ha potuto completare la richiesta."

#: clients/bluez/manager.cpp
msgid "This device is no longer available."
msgstr "Questo dispositivo non è più disponibile."

#: clients/bluez/manager.cpp
msgid "The device is busy. Try again in a moment."
msgstr "Il dispositivo è occupato. Riprova tra poco."

#: clients/bluez/manager.cpp
msgid "Bluetooth isn't ready yet. Try again in a moment."
msgstr "Il Bluetooth non è ancora pronto. Riprova tra poco."

#: clients/bluez/manager.cpp
msgid "This device has no media player."
msgstr "Questo dispositivo non ha un lettore multimediale."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent: no system bus."
msgstr "Impossibile esportare l’agente di abbinamento Bluetooth: nessun bus di sistema."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent."
msgstr "Impossibile esportare l’agente di abbinamento Bluetooth."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "Inserisci un PIN di 1–16 byte."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "Inserisci una passkey di 1–6 cifre."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "Impossibile connettersi a {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "Impossibile connettersi al dispositivo"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "Impossibile disconnettere {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "Impossibile disconnettere il dispositivo"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "Impossibile abbinare {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "Impossibile abbinare il dispositivo"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "Impossibile dimenticare {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "Impossibile dimenticare il dispositivo"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Riprova. Se continua a non riuscire, spegni e riaccendi il dispositivo."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "Il dispositivo non ha risposto in tempo. Assicurati che sia acceso e nelle vicinanze."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "Il dispositivo non ha risposto. Assicurati che sia acceso, nelle vicinanze e non connesso a un altro dispositivo."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "Il dispositivo non riconosce più questo computer. Dimentica il dispositivo e abbinalo di nuovo."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "Abbinamento non riuscito. Assicurati che il codice corrisponda su entrambi i dispositivi e riprova."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "Il dispositivo ha rifiutato la richiesta."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "Il dispositivo ha rifiutato la connessione."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "Il dispositivo non offre funzioni utilizzabili da questo computer."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Il Bluetooth è disattivato."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Troppi dispositivi connessi. Disconnettine uno e riprova."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "Il dispositivo ha chiuso la connessione."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "La connessione si è interrotta. Riprova."

#: clients/display/display_client.cpp
