#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Cannot unblock Bluetooth: {error}"
msgstr "Не удается разблокировать Bluetooth: {error}"

#: clients/bluez/manager.cpp
msgid "The device didn't finish pairing in time. Try again."
msgstr "Устройство не завершило создание пары вовремя. Повторите попытку."

#: clients/bluez/manager.cpp
msgid "The system D-Bus connection is unavailable."
msgstr "Подключение к системной шине D-Bus недоступно."

#: clients/bluez/manager.cpp
msgid "Bluetooth is blocked by a hardware switch."
msgstr "Bluetooth заблокирован аппаратным переключателем."

#: clients/bluez/manager.cpp
msgid "The Bluetooth service is unavailable."
msgstr "Служба Bluetooth недоступна."

#: clients/bluez/manager.cpp
msgid "Bluetooth couldn't complete the request."
msgstr "Bluetooth не удалось выполнить запрос."

#: clients/bluez/manager.cpp
msgid "This device is no longer available."
msgstr "Это устройство больше недоступно."

#: clients/bluez/manager.cpp
msgid "The device is busy. Try again in a moment."
msgstr "Устройство занято. Повторите попытку чуть позже."

#: clients/bluez/manager.cpp
msgid "Bluetooth isn't ready yet. Try again in a moment."
msgstr "Bluetooth еще не готов. Повторите попытку чуть позже."

#: clients/bluez/manager.cpp
msgid "This device has no media player."
msgstr "У этого устройства нет медиаплеера."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent: no system bus."
msgstr "Не удается экспортировать агент создания пары Bluetooth: нет системной шины."

#: clients/bluez/manager.cpp
msgid "Cannot export the Bluetooth pairing agent."
msgstr "Не удается экспортировать агент создания пары Bluetooth."

#: clients/bluez/manager.cpp
msgid "Enter a PIN containing 1–16 bytes."
msgstr "Введите PIN-код длиной от 1 до 16 байт."

#: clients/bluez/manager.cpp
msgid "Enter a passkey containing 1–6 digits."
msgstr "Введите ключ доступа из 1–6 цифр."

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't connect to {device}"
msgstr "Не удалось подключиться к {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't connect to the device"
msgstr "Не удалось подключиться к устройству"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't disconnect {device}"
msgstr "Не удалось отключить {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't disconnect the device"
msgstr "Не удалось отключить устройство"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't pair with {device}"
msgstr "Не удалось создать пару с {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't pair with the device"
msgstr "Не удалось создать пару с устройством"

#: clients/bluez/manager.cpp
#, python-brace-format
msgid "Couldn't forget {device}"
msgstr "Не удалось забыть {device}"

#: clients/bluez/manager.cpp
msgid "Couldn't forget the device"
msgstr "Не удалось забыть устройство"

#: clients/bluez/manager.cpp
msgid "Try again. If it keeps failing, turn the device off and on again."
msgstr "Повторите попытку. Если ошибка повторяется, выключите и снова включите устройство."

#: clients/bluez/manager.cpp
msgid "The device didn't respond in time. Make sure it is turned on and nearby."
msgstr "Устройство не ответило вовремя. Убедитесь, что оно включено и находится рядом."

#: clients/bluez/manager.cpp
msgid "The device didn't respond. Make sure it is turned on, nearby, and not connected to another device."
msgstr "Устройство не отвечает. Убедитесь, что оно включено, находится рядом и не подключено к другому устройству."

#: clients/bluez/manager.cpp
msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "Устройство больше не распознает этот компьютер. Забудьте устройство и создайте пару заново."

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "Не удалось создать пару. Убедитесь, что код совпадает на обоих устройствах, и повторите попытку."

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "Устройство отклонило запрос."

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "Устройство отказало в подключении."

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "У устройства нет функций, которые может использовать этот компьютер."

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "Bluetooth выключен."

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "Подключено слишком много устройств. Отключите одно из них и повторите попытку."

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "Устройство разорвало подключение."

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "Подключение прервано. Повторите попытку."

#: clients/display/display_client.cpp
msgid "The display operation timed out."
msgstr "Время ожидания операции с дисплеем истекло."

#: clients/display/display_client.cpp
msgid "The display service restarted."
msgstr "Служба дисплеев перезапустилась."

#: clients/display/display_client.cpp
msgid "Unexpected display state."
msgstr "Непредвиденное состояние дисплея."

#: clients/display/output_model.cpp
msgid "Built-in Display"
msgstr "Встроенный дисплей"

#. TRANSLATORS: a monitor and the port it is plugged into, such as "DELL U2720Q (DP-1)".
#: clients/display/output_model.cpp
#, python-brace-format
msgid "{name} ({connector})"
msgstr "{name} ({connector})"

#. TRANSLATORS: a screen resolution in pixels, such as "1920 × 1080".
#: clients/display/output_model.cpp
#, python-brace-format
msgid "{width} × {height}"
msgstr "{width} × {height}"

#. TRANSLATORS: a refresh rate, such as "60.00 Hz".
#: clients/display/output_model.cpp
#, python-brace-format
msgid "{rate} Hz"
msgstr "{rate} Гц"

#. TRANSLATORS: the choice that shows other content on this display instead of mirroring another one.
#: clients/display/output_model.cpp
msgid "Extend"
msgstr "Расширить"

#: clients/display/screen.cpp
msgid "The display service is unavailable."
msgstr "Служба дисплеев недоступна."

#: clients/display/screen.cpp
msgid "Displays changed. The previous draft was discarded."
msgstr "Дисплеи изменились. Предыдущий черновик настроек отброшен."

#: clients/networkmanager/handler.cpp
msgid "The hotspot could not be started. The Wi-Fi adapter may not support it on this channel or with this password."
msgstr "Не удалось запустить точку доступа. Возможно, адаптер Wi-Fi не поддерживает ее на этом канале или с этим паролем."

#: clients/networkmanager/handler.cpp
msgid "No Wi-Fi adapter can run a hotspot."
msgstr "Нет адаптера Wi-Fi, способного работать как точка доступа."

#: clients/networkmanager/handler.cpp
msgid "No VPN plugin can read this file. Install the one for your VPN, for example network-manager-openvpn for OpenVPN."
msgstr "Ни один модуль VPN не может прочитать этот файл. Установите модуль для вашей VPN, например network-manager-openvpn для OpenVPN."

#: clients/networkmanager/handler.cpp
msgid "This file isn't a VPN configuration this system can read."
msgstr "Этот файл не является конфигурацией VPN, которую может прочитать система."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which reads VPN files, is not installed."
msgstr "Программа nmcli, читающая файлы VPN, не установлена."

#: clients/networkmanager/handler.cpp
msgid "The private key can't be read, so the file would be incomplete."
msgstr "Не удается прочитать закрытый ключ, поэтому файл был бы неполным."

#: clients/networkmanager/handler.cpp
msgid "The file can't be written."
msgstr "Не удается записать файл."

#: clients/networkmanager/handler.cpp
msgid "nmcli, which writes VPN files, is not installed."
msgstr "Программа nmcli, записывающая файлы VPN, не установлена."

#: clients/networkmanager/handler.cpp
msgid "The VPN couldn't be written to a file."
msgstr "Не удалось записать VPN в файл."

