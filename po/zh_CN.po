msgid "The device no longer recognizes this computer. Forget the device and pair it again."
msgstr "设备已不再识别这台电脑。请忽略该设备，然后重新配对。"

#: clients/bluez/manager.cpp
msgid "Pairing failed. Make sure the code matches on both devices and try again."
msgstr "配对失败。请确保两台设备上的代码一致，然后重试。"

#: clients/bluez/manager.cpp
msgid "The device declined the request."
msgstr "设备拒绝了该请求。"

#: clients/bluez/manager.cpp
msgid "The device refused the connection."
msgstr "设备拒绝了连接。"

#: clients/bluez/manager.cpp
msgid "The device has no features this computer can use."
msgstr "此设备没有这台电脑可以使用的功能。"

#: clients/bluez/manager.cpp
msgid "Bluetooth is turned off."
msgstr "蓝牙已关闭。"

#: clients/bluez/manager.cpp
msgid "Too many devices are connected. Disconnect one and try again."
msgstr "连接的设备过多。请断开一个设备，然后重试。"

#: clients/bluez/manager.cpp
msgid "The device ended the connection."
msgstr "设备结束了连接。"

#: clients/bluez/manager.cpp
msgid "The connection was interrupted. Try again."
msgstr "连接已中断。请重试。"

